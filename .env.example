# ─── NEP Platform Environment Variables ───────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ── Supabase (Sprint 1 — auth + database) ─────────────────────────────────
# Get these from: https://app.supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Resend (Sprint 2 — doctor invite emails) ──────────────────────────────
# Set these as Supabase Edge Function secrets (not here — never expose in frontend)
# supabase secrets set RESEND_API_KEY=re_...
# supabase secrets set FROM_EMAIL=invites@yourdomain.com
# supabase secrets set APP_URL=https://nep-dun.vercel.app
# Get your API key from: https://resend.com/api-keys
# Your sender domain must be verified in Resend first.

# ── Anthropic API (Sprint 3 — paper expansion) ────────────────────────────
# Used by the backend worker only — DO NOT expose in frontend
# ANTHROPIC_API_KEY=sk-ant-...
# Model id — set this (also as a Supabase Edge Function secret for
# ai-generate: supabase secrets set ANTHROPIC_MODEL=...) if the default
# below isn't available to your API key. Check console.anthropic.com for
# models your account can access.
# ANTHROPIC_MODEL=claude-sonnet-5

# ── AWS S3 (Sprint 3 — file storage) ──────────────────────────────────────
# Used by the backend worker only — DO NOT expose in frontend
# AWS_REGION=eu-west-1
# AWS_S3_BUCKET=nep-papers-prod
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ── Stripe (Sprint 4 — billing) ───────────────────────────────────────────
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...

# ── App config ────────────────────────────────────────────────────────────
VITE_APP_VERSION=0.1.0
VITE_API_BASE_URL=http://localhost:3001

# ── Current adapter ───────────────────────────────────────────────────────
# "mock"     → MockAdapter (default, no backend needed)
# "supabase" → SupabaseAdapter (requires VITE_SUPABASE_* above)
# "rest"     → RestAdapter (requires VITE_API_BASE_URL above)
VITE_API_ADAPTER=mock
